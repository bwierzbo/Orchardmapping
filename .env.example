# Postgres (Neon via Vercel). Both names point at the same database.
DATABASE_URL=your_database_url_here
POSTGRES_URL=your_postgres_url_here

# Clerk (auth) — auto-provisioned by `vercel integration add clerk`,
# or copy from the Clerk dashboard.
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Vercel Blob storage (PMTiles + preview images).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# WSU AgWeatherNet (weather.wsu.edu) — optional.
# Station weather, and critically a MEASURED leaf wetness sensor
# (LW_UNITY, where 0.4 is defined as wet) in place of Open-Meteo's
# modelled probability, which models dew rather than rain and is
# switched off in the scab model for that reason.
#
# Register at weather.wsu.edu, then email weather@wsu.edu to have API
# access enabled — it is granted, not self-serve.
AGWEATHERNET_USERNAME=…
AGWEATHERNET_PASSWORD=…

# Shared token for POST /api/weather/ingest — a weather station at the
# orchard cannot sign in, so it presents this instead. Unset means the
# endpoint refuses everything, which is the right default.
WEATHER_INGEST_TOKEN=…
