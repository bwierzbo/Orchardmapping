# Postgres (Neon via Vercel). Both names point at the same database;
# @vercel/postgres reads POSTGRES_URL, scripts accept DATABASE_URL too.
DATABASE_URL=your_database_url_here
POSTGRES_URL=your_postgres_url_here

# Auth.js (NextAuth v5). Generate a secret with: openssl rand -base64 32
# The legacy NEXTAUTH_URL/NEXTAUTH_SECRET names still work but AUTH_* is canonical.
AUTH_URL=http://localhost:3000
AUTH_SECRET=your_random_secret_here

# Vercel Blob storage (PMTiles + preview images).
# From the Vercel dashboard: Storage -> your Blob store -> tokens.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# First admin user, consumed only by `pnpm db:seed-admin`.
ADMIN_EMAIL=admin@orchard.local
ADMIN_PASSWORD=change_this_password_now
ADMIN_NAME=Admin
